# 用法：cp .env.example .env，然后在 .env 里填真实值
# .env 已被 .gitignore 忽略，绝不要提交
#
# 国内平台都兼容 OpenAI SDK 协议，代码不用改，只换 base_url + model：
#   DeepSeek    base_url=https://api.deepseek.com/v1  model=deepseek-flash
#   阿里百炼     base_url=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
#   硅基流动     base_url=https://api.siliconflow.cn/v1  model=deepseek-ai/DeepSeek-V3
#
# 注意 DeepSeek 现役模型名是 deepseek-flash / deepseek-v4-pro（2026-11 核对），
# 旧的 deepseek-chat 已属遗留名，别照老教程抄。

# ---- 必填 ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# ---- 可选：不填就用下面的默认值，命令行参数优先级更高 ----
# 单次请求超时（秒）。SDK 默认 600s 太久，用户会盯着卡死的界面十分钟
# OPENAI_TIMEOUT=30
# 单次回答最大 token 数，越小越省钱
# OPENAI_MAX_TOKENS=512
# 最多尝试次数（含首发），3 = 首发 + 2 次重试
# OPENAI_RETRIES=3
